# Copy this file to .env and fill in the keys you have. Never upload the real .env.
LLM_PROVIDER=gemini          # gemini | openai | groq | cerebras | openrouter | ollama
GEMINI_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
CEREBRAS_API_KEY=your-cerebras-key-here

# Optional second keys (a separate quota each), tried automatically when the first key is rate-limited:
# GEMINI_API_KEY_2=your-second-gemini-key   (a different Google project: its own daily quota)
# GEMINI_API_KEY_3=your-third-gemini-key

# Optional settings (defaults shown)
# LLM_MODEL=                   # override the provider's default model
# LLM_FALLBACKS=gemini2:gemini-3.5-flash-lite,gemini3:gemini-3.5-flash-lite,groq,openrouter   # providers or provider:model entries to try if the main one fails
# PDF_MAX_WORDS=1200           # send only the matching PDF sections (useful for free tiers with small token limits)
# AGENT_TEMPERATURE=0.4
# REFLECTION=on                # reflection step (bonus); logs drafts and revisions to logs/reflection.jsonl
# ROUTER_USE_LLM=on
# VERBOSE=1

# Optional, for a Hugging Face Space (leave these out when running locally):
# LOGS_REPO=your-username/cedarsun-logs   # copy the logs to this private Dataset so they survive restarts
# HF_TOKEN=your-hugging-face-write-token   # keep it a Space secret; needed for LOGS_REPO
# LOGS_TOKEN=a-long-random-string          # secret that opens the owner-only "logs" API (closed when not set)
